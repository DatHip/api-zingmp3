{
   "version": 2,
   "builds": [
      {
         "src": "server.js",
         "use": "@vercel/node",
         "config": { "memory": 512, "maxDuration": 10 }
      }
   ],
   "routes": [
      {
         "src": "/(.*)",
         "dest": "server.js"
      }
   ],
   "headers": [
      {
         "source": "/api/(.*)",
         "headers": [
            {
               "key": "Access-Control-Allow-Credentials",
               "value": "true"
            }
         ]
      }
   ]
}
