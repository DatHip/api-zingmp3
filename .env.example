PORT=5000

# Zing MP3 web-client credentials.
# zingClient.js ships working defaults; only set these if Zing rotates the keys.
# Left blank here on purpose — do not commit real values to an example file.
ZING_BASE=https://zingmp3.vn
ZING_SUGGEST_BASE=https://ac.zingmp3.vn
ZING_API_KEY=
ZING_SECRET_KEY=
ZING_VERSION=1.9.20
ZING_UA=

# Per-upstream-call timeout. A cold request makes TWO sequential calls (cookie
# handshake + API), so keep 2 * this value below vercel.json's maxDuration.
ZING_TIMEOUT_MS=3500
ZING_COOKIE_TTL_MS=600000

# CORS whitelist. Comma-separated; localhost:* is always allowed. Entries may
# use `*` to match one hostname label, which is how you allow a project's
# preview deployments (their hostname changes on every build):
#   CORS_ORIGINS=https://zing-mp3-d4t.vercel.app,https://zing-mp3-d4t-*.vercel.app
CORS_ORIGINS=

# Cache + circuit breaker
CACHE_STALE_MULT=3
CACHE_MAX_KEYS=5000
BREAKER_WINDOW_MS=30000
BREAKER_THRESHOLD=3
BREAKER_OPEN_MS=300000
